# Copy to .env. Used by docker compose (variable substitution) and by the app (pydantic-settings).
# Defaults match docker-compose.yml, so the app can run on the host against the Compose stack.

# --- Postgres ---
POSTGRES_USER=housing
POSTGRES_PASSWORD=housing
POSTGRES_DB=housing
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://housing:housing@localhost:5432/housing

# --- Redis (cache, rate limits, job queue) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=redis

# --- Object storage (SeaweedFS S3 locally; AWS S3 / R2 later) ---
STORAGE_PORT=8333
STORAGE_ENDPOINT=http://localhost:8333
STORAGE_BUCKET=housing-raw
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=housing
STORAGE_SECRET_KEY=housing-secret
STORAGE_CONNECT_TIMEOUT_S=3
STORAGE_READ_TIMEOUT_S=10
STORAGE_MAX_ATTEMPTS=2

# --- LLM (LiteLLM model strings) ---
OLLAMA_PORT=11434
OLLAMA_MODEL=qwen3.5:4b
LLM_MODEL_EXTRACT=ollama_chat/qwen3.5:4b
OLLAMA_API_BASE=http://localhost:11434
LLM_TIMEOUT_S=120
LLM_REASONING_EFFORT=none

# --- Sources (comma-separated) ---
SOURCES_ENABLED=huurwoningen
HUURWONINGEN_TIMEOUT_S=20
# curl_cffi browser profile (chrome, safari, firefox, ...); change it if the site starts blocking
HUURWONINGEN_IMPERSONATE=chrome
# seconds between requests to the site from one worker (keeps backfills low-volume)
HUURWONINGEN_MIN_INTERVAL_S=2

# --- Scheduled sync (worker) ---
# Mirror this city's listings every SYNC_EVERY_MIN minutes; empty SYNC_CITY turns it off.
SYNC_CITY=rotterdam
SYNC_EVERY_MIN=15
# Background summaries: seconds of LLM work per run (runs every minute, one call at a time)
SUMMARY_BATCH_S=240

# --- API ---
API_PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
